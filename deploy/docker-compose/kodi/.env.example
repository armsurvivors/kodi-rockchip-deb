# Copy to .env (next to docker-compose.yaml) and adjust; Compose loads it automatically.

TZ=Europe/Amsterdam

# Kodi image; the tag suffix picks the flavor, which must match the host kernel:
#   v4l2requests: mainline kernel (e.g. Armbian rockchip64 edge), V4L2 stateless decoders
#   rkmpp:        Rockchip vendor kernel (e.g. Armbian rk35xx vendor), rkmpp + rkrga
# Tags are ghcr.io/armsurvivors/kodi-rockchip-deb:<distro>-<flavor>-latest; for mainline kernels use:
#   KODI_IMAGE=ghcr.io/armsurvivors/kodi-rockchip-deb:trixie-v4l2requests-latest
KODI_IMAGE=ghcr.io/armsurvivors/kodi-rockchip-deb:trixie-rkmpp-latest

# Host directory holding Kodi's userdata.
KODI_DATA_DIR=/root/.kodi

# Kodi audio backend: alsa, pulseaudio, or alsa+pulseaudio (PulseAudio when the host runs it, else ALSA).
KODI_AUDIO_BACKEND=alsa+pulseaudio
