# Copy to .env (next to docker-compose.yaml) and adjust; Compose loads it automatically.
# Emptying a required value makes `docker compose up` fail with a message naming it.

TZ=Europe/Amsterdam

# Kodi image; the tag suffix picks the flavor, which must match the host kernel:
#   v4l2requests: mainline kernel (e.g. Armbian rockchip64 edge), V4L2 stateless decoders
#   rkmpp:        Rockchip vendor kernel (e.g. Armbian rk35xx vendor), rkmpp + rkrga
# Tags are ghcr.io/armsurvivors/kodi-rockchip-deb:<distro>-<flavor>-latest; for mainline kernels use:
#   KODI_IMAGE=ghcr.io/armsurvivors/kodi-rockchip-deb:trixie-v4l2requests-latest
KODI_IMAGE=ghcr.io/armsurvivors/kodi-rockchip-deb:trixie-rkmpp-latest

# Companion images are flavor-independent.
PULSE_IMAGE=ghcr.io/armsurvivors/kodi-rockchip-deb/pulseaudio:trixie-latest
SENDSPIN_IMAGE=ghcr.io/armsurvivors/kodi-rockchip-deb/sendspin:trixie-latest

# Host directory holding Kodi's userdata.
KODI_DATA_DIR=/root/.kodi

# Required: ALSA card ID, the [ID] column of `cat /proc/asound/cards`.
PULSE_ALSA_DEVICE_ID=CODEC
PULSE_CARD_PROFILE=output:analog-stereo

# Required: IR receiver's event node, from `ls /dev/input/by-id/`.
IR_BY_ID=/dev/input/by-id/usb-Topseed_Technology_Corp._eHome_Infrared_Transceiver_TS000Jot-event-if00

# Required: Music Assistant player identity; keep SENDSPIN_ID stable across restarts.
SENDSPIN_ID=sendspin-cli-cm3588-nas-8ql9vcv5sd
SENDSPIN_NAME=cm3588-nas-in-cluster
SENDSPIN_MANUFACTURER=Armsurvivors
SENDSPIN_PRODUCT_NAME=sendspin-in-cluster-insanity
