#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1
export DEB_BUILD_OPTIONS=nostrip

%:
	dh $@

override_dh_installsystemd:
	dh_installsystemd -pkodi-rockchip-gbm --name=kodi --no-enable --no-start
	dh_installsystemd -pkodi-rockchip-gbm --name=kodi-pulse --no-enable --no-start
	dh_installsystemd -pkodi-rockchip-gbm --name=pulseaudio --no-enable --no-start

override_dh_usrlocal:
	# Intentionally left blank to prevent dh_usrlocal from running. I'm *evil* and packaging stuff in /usr/local. Fire me.
