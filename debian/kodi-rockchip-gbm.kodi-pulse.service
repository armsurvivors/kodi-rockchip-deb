[Unit]
Description=kodi rockchip gbm standalone via pulse
After=network-online.target pulseaudio.service

[Service]
EnvironmentFile=-/etc/default/kodi-rockchip-gbm
Environment=HOME=/root
Environment=PULSE_SERVER=127.0.0.1
# Vendor kernel (rkmpp) only: set required interval for mpp utilization statistics https://github.com/armbian/linux-rockchip/commit/22c5e525ac2d6f7e17a8ba4722bf99240ee027a2 - see it with watch -n 1 cat /proc/mpp_service/load
# Skipped if absent (mainline kernel, v4l2requests), so it never fails the unit.
ExecStartPre=/bin/bash -c 'if [ -w /proc/mpp_service/load_interval ]; then echo 1000 > /proc/mpp_service/load_interval; fi'
ExecStart=/usr/local/bin/kodi --logging=console --windowing=gbm --audio-backend=pulseaudio
TimeoutStopSec=5
Restart=always
RestartSec=2
StartLimitInterval=0
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
