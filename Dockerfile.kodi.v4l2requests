# Warning to the reader. This produces a .deb package with stuff in /usr/local. If this scares you, stop reading.
# It is in fact, non-debian packaging. Probably fpm would be a better choice?
ARG BASE_IMAGE="debian:trixie"
FROM ${BASE_IMAGE} AS packager

#### Dependencies. This is built under buildx and layers not published so we don't care about layer size.
ENV DEBIAN_FRONTEND=noninteractive
ENV FORCE_COLOR=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked <<-ALL_DEB_DEPS
ls -laR /etc/apt/apt.conf.d
for ja in /etc/apt/apt.conf.d/*; do
	echo "APT CONF.D ITEM: $ja"
	cat "$ja"
done
rm -rfv /etc/apt/apt.conf.d/docker-clean /etc/apt/apt.conf.d/docker-gzip-indexes

# Trixie's stock linux-libc-dev (6.12) lacks some of the V4L2 stateless uAPI we need; take (only) it from trixie-backports.
. /etc/os-release
if [ "${ID}" = "debian" ] && [ "${VERSION_CODENAME}" = "trixie" ]; then
	echo "Debian trixie detected: enabling trixie-backports for linux-libc-dev"
	cat > /etc/apt/sources.list.d/trixie-backports.sources <<- BACKPORTS_SOURCES
		Types: deb
		URIs: http://deb.debian.org/debian
		Suites: trixie-backports
		Components: main
		Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	BACKPORTS_SOURCES
	cat > /etc/apt/preferences.d/linux-libc-dev-backports <<- BACKPORTS_PIN
		Package: linux-libc-dev
		Pin: release n=trixie-backports
		Pin-Priority: 990
	BACKPORTS_PIN
fi

apt-get -y update
apt-get -y dist-upgrade
apt-get -y install \
	git bash wget curl build-essential devscripts debhelper pkg-config cmake meson tree \
	debhelper autoconf automake autopoint gettext autotools-dev curl gawk gcc gdc gperf \
	libtool lsb-release meson nasm ninja-build python3-dev python3-pil python3-pip unzip \
	uuid-dev zip libdrm-dev hwdata libasound2-dev libass-dev libavahi-client-dev \
	libavahi-common-dev libbluetooth-dev libbluray-dev libbz2-dev libcdio-dev \
	libcdio++-dev libp8-platform-dev libcrossguid-dev libcurl4-openssl-dev libcwiid-dev \
	libdbus-1-dev libegl1-mesa-dev libenca-dev libexiv2-dev libflac-dev libfmt-dev \
	libfontconfig-dev libfreetype6-dev libfribidi-dev libfstrcmp-dev libgcrypt-dev \
	libgif-dev libgles2-mesa-dev libgl1-mesa-dev libglu1-mesa-dev libgnutls28-dev \
	libgpg-error-dev libgtest-dev libiso9660-dev libjpeg-dev liblcms2-dev libltdl-dev \
	liblzo2-dev libmicrohttpd-dev libnfs-dev libogg-dev libpcre2-dev libplist-dev \
	libpng-dev libpulse-dev libshairplay-dev libsmbclient-dev libspdlog-dev \
	libsqlite3-dev libssl-dev libtag1-dev libtiff5-dev libtinyxml-dev libtinyxml2-dev \
	libudev-dev libunistring-dev libvorbis-dev libxslt1-dev libxt-dev libxrandr-dev rapidjson-dev \
	zlib1g-dev default-jre libgbm-dev libinput-dev libxkbcommon-dev libcec-dev \
	libmariadb-dev liblirc-dev nlohmann-json3-dev bison patchelf

du -h /var/cache/apt
du -h /var/lib/apt
ALL_DEB_DEPS

# Lets ensure the libc/linux headers are recent enough for the stateless decoders we need, otherwise bail out fast.
# Every check runs (so the log shows the full picture); the build aborts afterwards if any of them failed.
RUN <<-HEADERS_CHECK
missing=0
check() { # usage: check <label> <symbol that linux/videodev2.h must define>
    if printf '#include <linux/videodev2.h>\nint i = %s;\n' "$2" | gcc -x c -c - -o /dev/null 2>/dev/null; then
        printf '  [ OK ] %-9s %s\n' "$1" "$2"
    else
        printf '  [FAIL] %-9s %s\n' "$1" "$2"; missing=$((missing + 1))
    fi
}

echo "Checking linux/videodev2.h for V4L2 stateless decoder support:"
check H264     V4L2_CID_STATELESS_H264_DECODE_MODE
check HEVC     V4L2_CID_STATELESS_HEVC_SPS
check HEVC-EXT V4L2_CID_STATELESS_HEVC_EXT_SPS_ST_RPS
check HEVC-EXT V4L2_CID_STATELESS_HEVC_EXT_SPS_LT_RPS
check HEVC-EXT V4L2_HEVC_EXT_SPS_ST_RPS_FLAG_INTER_REF_PIC_SET_PRED
check VP9      V4L2_CID_STATELESS_VP9_FRAME
check AV1      V4L2_CID_STATELESS_AV1_SEQUENCE

[ "$missing" -eq 0 ] || { echo "ERROR: $missing V4L2 stateless symbol(s) missing; linux headers too old, aborting." >&2; exit 1; }
echo "All V4L2 stateless decoder symbols present."
HEADERS_CHECK

#### Git clones. Heavy stuff.
ARG FFMPEG_BRANCH="n9.0.2"
ARG DAV1D_BRANCH="1.5.4"
ARG KODI_BRANCH="master"
ARG FLAVOR="v4l2requests"
SHELL ["/bin/bash", "-e", "-c"]
WORKDIR /src
RUN git -c advice.detachedHead=false clone https://gitlab.freedesktop.org/emersion/libdisplay-info.git libdisplay-info && \
    git -c advice.detachedHead=false clone -b "${DAV1D_BRANCH}" --depth=1 --single-branch https://code.videolan.org/videolan/dav1d.git dav1d && \
    git -c advice.detachedHead=false clone -b "${FFMPEG_BRANCH}" --depth=1 --single-branch https://github.com/FFmpeg/FFmpeg.git ffmpeg && \
    git -c advice.detachedHead=false clone -b "${KODI_BRANCH}" --depth=1 --single-branch https://github.com/xbmc/xbmc.git kodi

#### Builds

# We'll build into /usr/local, so zero that out to get a clean slate. Yeah, not too smart, but it works.
RUN rm -rfv /usr/local/*

# dav1d: fast software AV1 decoder, built from source. Enables AV1 software fallback in ffmpeg.
# h264/hevc/vp9 software decoders are already native to ffmpeg; AV1's native decoder is too slow, so we bring dav1d.
WORKDIR /src/dav1d
RUN meson setup build --prefix=/usr/local --libdir=lib --buildtype=release --default-library=shared -Denable_tools=false -Denable_tests=false && \
    ninja -C build install

# ffmpeg, from source. patches from the amazing Karlman, Casanova, Brezillon, Hewitt....
ADD patches/ffmpeg /src/patches-ffmpeg
WORKDIR /src/ffmpeg
RUN for p in /src/patches-ffmpeg/v4l2requests/9.0.2/*.patch; do echo "Applying patch ${p} ..."; patch -p1 < "$p"; done

# Build ffmpeg
WORKDIR /src/ffmpeg
RUN ./configure --prefix=/usr/local --enable-gpl --enable-version3 --enable-libdrm  --enable-libdav1d --enable-v4l2_m2m --enable-libdrm && \
    make -j $(nproc) && \
    make install

RUN LD_LIBRARY_PATH=/usr/local/lib /usr/local/bin/ffmpeg -hide_banner -decoders | tee /tmp/decoders.txt && \
    for d in h264 hevc vp9 av1 libdav1d h264_v4l2m2m hevc_v4l2m2m vp9_v4l2m2m; do \
      grep -qw "$d" /tmp/decoders.txt || { echo "MISSING DECODER: $d"; exit 1; }; \
    done && \
    echo "All expected decoders present."

RUN { LD_LIBRARY_PATH=/usr/local/lib /usr/local/bin/ffmpeg -hide_banner -buildconf | grep -q -- '--disable-asm' && { echo "ERROR: ffmpeg asm disabled"; exit 1; }; } || echo "ffmpeg asm enabled."

# Libdisplay-info, a hard dependency for kodi GBM.
WORKDIR /src/libdisplay-info
RUN mkdir build && cd build && meson setup --prefix=/usr/local --buildtype=release .. && ninja && ninja install

# Show Kodi revision we're about to build...
WORKDIR /src/kodi
RUN git rev-parse HEAD

# Add some patches, taken from LibreELEC.
ADD patches/kodi /src/patches-kodi
WORKDIR /src/kodi
RUN for p in /src/patches-kodi/common/*.patch; do echo "Applying patch ${p} ..."; patch -p1 < "$p"; done
RUN for p in /src/patches-kodi/drmprime-filter/*.patch; do echo "Applying patch ${p} ..."; patch -p1 < "$p"; done

# Kodi build. the --build step actually downloads things and that might fail, so retry it a few times.
# GIT_VERSION replaces Kodi's git stamp, shown as "Git:" in System Information and in the log header; tells flavor apart.
# It ends up unquoted in a cmake command line, so only [A-Za-z0-9._-] allowed.
# PACKAGE_VERSION is declared only here, as any change to it invalidates the cache from this point on (Kodi build included).
WORKDIR /src/kodi-build
ARG PACKAGE_VERSION="20260513"
RUN KODI_COMMIT="$(git -C ../kodi log -1 --date=format:%Y%m%d --format=%cd-%h)" && \
    KODI_GIT_VERSION="${KODI_COMMIT}-${FLAVOR}-ffmpeg-${FFMPEG_BRANCH}-$(lsb_release -c -s)-build-${PACKAGE_VERSION}" && \
    { [[ "${KODI_GIT_VERSION}" =~ ^[0-9]{8}-[0-9a-f]{7,}-[A-Za-z0-9._-]+$ ]] || { echo "ERROR: bad Kodi GIT_VERSION '${KODI_GIT_VERSION}'" >&2; exit 1; }; } && \
    echo "${KODI_GIT_VERSION}" | tee /src/kodi-git-version
RUN cmake ../kodi -DCMAKE_INSTALL_PREFIX=/usr/local -DCORE_PLATFORM_NAME=gbm -DAPP_RENDER_SYSTEM=gles -DENABLE_INTERNAL_FMT=ON -DENABLE_INTERNAL_FLATBUFFERS=ON -DENABLE_INTERNAL_TAGLIB=ON -DENABLE_INTERNAL_SWIG=ON -DGIT_VERSION="$(< /src/kodi-git-version)" && \
    cmake --build . -- -j$(nproc) || cmake --build . -- -j$(nproc) || cmake --build . -- -j$(nproc) && \
    make install

# Lets build & install shadertoy visualization addon
WORKDIR /src
RUN git clone --branch Piers https://github.com/xbmc/visualization.shadertoy.git
WORKDIR /src/visualization.shadertoy/build
RUN cmake -DADDONS_TO_BUILD=visualization.shadertoy -DAPP_RENDER_SYSTEM=gles -DADDON_SRC_PREFIX=../.. -DCMAKE_INSTALL_PREFIX=/usr/local/share/kodi/addons -DCMAKE_BUILD_TYPE=Release -DPACKAGE_ZIP=1 /src/kodi/cmake/addons
RUN make

# Lets build & install shadertoy screensaver addon
WORKDIR /src
RUN git clone --branch Piers https://github.com/xbmc/screensaver.shadertoy.git
WORKDIR /src/screensaver.shadertoy/build
RUN cmake -DADDONS_TO_BUILD=screensaver.shadertoy -DAPP_RENDER_SYSTEM=gles -DADDON_SRC_PREFIX=../.. -DCMAKE_INSTALL_PREFIX=/usr/local/share/kodi/addons -DCMAKE_BUILD_TYPE=Release -DPACKAGE_ZIP=1 /src/kodi/cmake/addons
RUN make

# Lets preinstall the Jellyfin Kodi repository add-on, just for convenience
WORKDIR /usr/local/share/kodi/addons
RUN wget "https://kodi.jellyfin.org/repository.jellyfin.kodi.zip"
RUN unzip repository.jellyfin.kodi.zip
RUN rm repository.jellyfin.kodi.zip
RUN ls -lah /usr/local/share/kodi/addons /usr/local/share/kodi/addons/repository.jellyfin.kodi

# Pin our own /usr/local libs (dav1d, libdisplay-info, plus MPP/RGA for rkmpp; FFmpeg itself is static) via RUNPATH:
# ld.so.conf lists /usr/lib/<triplet> before /usr/local/lib, so eg. a distro libdav1d7 (pulled by any distro libavcodec)
# or a PPA's librockchip-mpp1 would otherwise be picked at runtime instead of ours.
RUN <<-SET_RUNPATH
runpath="/usr/local/lib:/usr/local/lib/$(gcc -dumpmachine)"
for elf in /usr/local/lib/kodi/kodi-gbm /usr/local/bin/ffmpeg /usr/local/bin/ffprobe; do
	[ -f "${elf}" ] || { echo "ERROR: ${elf} not found" >&2; exit 1; }
	patchelf --set-rpath "${runpath}" "${elf}"
	readelf -d "${elf}" | grep -F "RUNPATH" || { echo "ERROR: no RUNPATH on ${elf}" >&2; exit 1; }
done
SET_RUNPATH

### ------- packaging

# Drop headers for now. We don't need them in the final package.
WORKDIR /pkg/src/usr
RUN rm -rf /usr/local/include && cp -pr /usr/local /pkg/src/usr/

# Prepare debian binary package
WORKDIR /pkg/src
ADD debian /pkg/src/debian
# Appliance settings: default to DRM PRIME hw accel + Direct-To-Plane rendering. Kodi loads it from special://xbmc/system/settings/.
ADD kodi/appliance.xml /pkg/src/usr/local/share/kodi/system/settings/appliance.xml

# For Pulseaudio, we need to add a system.pa file. This is a hack.
# The unit file sets env PULSE_CONFIG_PATH=/usr/local/share/pulse-kodi
WORKDIR /pkg/src/usr/local/share/pulse-kodi
ADD pulseaudio/system.pa /pkg/src/usr/local/share/pulse-kodi/system.pa

WORKDIR /pkg/src
RUN echo "usr/*" > debian/kodi-rockchip-gbm.install

# Render flavor/version-specific metadata (debian/control, debian/changelog, appliance.xml build info). ARGs here invalidate the cache.
ADD packaging/render-metadata.sh /pkg/render-metadata.sh
ARG OS_ARCH="arm64"
ARG FFMPEG_ID="902v4l2requests"
RUN /pkg/render-metadata.sh /pkg/src && \
    python3 -c "import xml.etree.ElementTree as ET; ET.parse('/pkg/src/usr/local/share/kodi/system/settings/appliance.xml')" && \
    cat /pkg/src/debian/control /pkg/src/debian/changelog /pkg/src/usr/local/share/kodi/system/settings/appliance.xml

# Build the package, don't sign it, don't lint it, compress fast with xz
WORKDIR /pkg/src
RUN debuild --no-lintian --build=binary -us -uc -Zxz -z1

# Show package info
RUN file /pkg/*.deb && \
    dpkg-deb -I /pkg/*.deb && \
    dpkg-deb -f /pkg/*.deb && \
    apt-get install -y /pkg/*.deb

# Now prepare the real output: the .deb for this release and arch.
WORKDIR /artifacts
RUN cp -v /pkg/*.deb kodi-rockchip-gbm_${OS_ARCH}_kodi_${KODI_BRANCH}_ffmpeg_${FFMPEG_ID}_$(lsb_release -c -s).deb

# An intermediate stage, which is just the base image + the installed built package.
# Who wouldn't want to run Kodi in a container?
# Lets avoid a layer with the .deb as that is huge.
FROM ${BASE_IMAGE} AS containerized-kodi

# Install the built package. Bind-mount the .deb from the packager stage so it's
# only present during this RUN and never ends up in a published layer.
# re-use the apt cache from the build stage to avoid downloading stuff again.
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked  --mount=type=bind,from=packager,source=/artifacts,target=/debs <<-INSTALL_DEBS

ls -laR  /etc/apt/apt.conf.d; for ja in /etc/apt/apt.conf.d/*; do echo "APT CONF.D ITEM: $ja"; cat "$ja"; done
rm -rfv /etc/apt/apt.conf.d/docker-clean /etc/apt/apt.conf.d/docker-gzip-indexes

du -h /var/cache/apt
du -h /var/lib/apt
apt-get -y update
apt-get -y dist-upgrade
apt-get -y install /debs/*.deb pulseaudio-utils ir-keytable
INSTALL_DEBS

# Final stage is just the output deb
FROM scratch
COPY --from=packager /artifacts/* /