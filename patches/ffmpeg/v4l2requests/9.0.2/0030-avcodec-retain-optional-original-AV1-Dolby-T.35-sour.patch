From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CroqueMr <82093548+CroqueMr@users.noreply.github.com>
Date: Tue, 20 Oct 2026 14:59:44 +0000
Subject: [PATCH 30/44] avcodec: retain optional original AV1 Dolby T.35 source
 side data

Attach the validated ITU-T T.35 Dolby Vision payload of AV1 streams as
optional raw side data for CB1 diagnostics. Allocation or side data
failures only omit the copy; decoding is unchanged.

From libreelec-x86-DV R1.0.0-Beta4 (f0f947a), CB1/patches/ffmpeg/ffmpeg-9900-03-source-dovi-raw.patch
https://github.com/CroqueMr/libreelec-x86-DV
---
 libavcodec/itut35.c | 36 ++++++++++++++++++++++++++++++++++++
 libavcodec/itut35.h |  1 +
 libavutil/frame.h   |  3 ++-
 3 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/libavcodec/itut35.c b/libavcodec/itut35.c
index b41d41406d..0058c729c4 100644
--- a/libavcodec/itut35.c
+++ b/libavcodec/itut35.c
@@ -31,6 +31,34 @@
 #include "itut35.h"
 #include "version.h"
 
+// Retain already validated source syntax at the native metadata owner.
+// Allocation/side-data failure only omits diagnostics; decoding is unchanged.
+static AVBufferRef *itut_t35_dovi_raw(const FFITUTT35 *itut_t35)
+{
+    static const uint8_t header[] = { 0xB5, 0x00, 0x3B, 0x00, 0x00, 0x08, 0x00 };
+    AVBufferRef *raw;
+    if (itut_t35->country_code != 0xB5 || itut_t35->provider_code != 0x003B ||
+        itut_t35->provider_oriented_code != 0x800 || !itut_t35->payload ||
+        !itut_t35->payload_size || itut_t35->payload_size > 1024 * 1024 - sizeof(header))
+        return NULL;
+    raw = av_buffer_alloc(sizeof(header) + itut_t35->payload_size);
+    if (raw) {
+        memcpy(raw->data, header, sizeof(header));
+        memcpy(raw->data + sizeof(header), itut_t35->payload, itut_t35->payload_size);
+    }
+    return raw;
+}
+
+static void itut_t35_attach_dovi_raw(FFITUTT35Meta *metadata, AVFrame *frame)
+{
+    if (metadata->dovi_raw) {
+        if (!av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER,
+                                              metadata->dovi_raw))
+            av_buffer_unref(&metadata->dovi_raw);
+        metadata->dovi_raw = NULL;
+    }
+}
+
 int ff_itut_t35_parse_buffer(FFITUTT35 *const itut_t35, const uint8_t *buf,
                              size_t buf_size, int flags) {
     GetByteContext gb;
@@ -240,6 +268,9 @@ int ff_itut_t35_parse_payload_to_struct(FFITUTT35 *const itut_t35, FFITUTT35Aux
                 return AVERROR(ENOMEM);
             }
 
+            av_buffer_unref(&metadata->dovi_raw);
+            metadata->dovi_raw = itut_t35_dovi_raw(itut_t35);
+
             break;
         }
         case ITU_T_T35_PROVIDER_CODE_SMPTE: {
@@ -359,11 +390,15 @@ int ff_itut_t35_parse_payload_to_frame(FFITUTT35 *const itut_t35, FFITUTT35Aux *
                                                               metadata.dovi);
         if (!sd) {
             av_buffer_unref(&metadata.dovi);
+            av_buffer_unref(&metadata.dovi_raw);
             return AVERROR(ENOMEM);
         }
         metadata.dovi = NULL;
     }
 
+    if (avctx->codec_id == AV_CODEC_ID_AV1)
+        itut_t35_attach_dovi_raw(&metadata, frame);
+
     if (metadata.hdr_smpte2094_app5) {
         ret = ff_frame_new_side_data_from_buf(avctx, frame, AV_FRAME_DATA_DYNAMIC_HDR_SMPTE_2094_APP5,
                                               &metadata.hdr_smpte2094_app5);
@@ -399,5 +434,6 @@ void ff_itut_t35_unref(FFITUTT35Meta *metadata)
     av_buffer_unref(&metadata->hdr_smpte2094_app5);
     av_buffer_unref(&metadata->lcevc);
     av_buffer_unref(&metadata->dovi);
+    av_buffer_unref(&metadata->dovi_raw);
     av_buffer_unref(&metadata->hdr_vivid);
 }
diff --git a/libavcodec/itut35.h b/libavcodec/itut35.h
index 374433a4ff..01ab9a547c 100644
--- a/libavcodec/itut35.h
+++ b/libavcodec/itut35.h
@@ -65,6 +65,7 @@ typedef struct FFITUTT35Meta {
     AVBufferRef *hdr_smpte2094_app5;
     AVBufferRef *hdr_vivid;
     AVBufferRef *dovi;
+    AVBufferRef *dovi_raw; // optional AV1 source T.35 bytes, never a decode dependency
     AVFilmGrainAFGS1Params aom_film_grain;
 } FFITUTT35Meta;
 
diff --git a/libavutil/frame.h b/libavutil/frame.h
index 52adbc6288..c837c97ef5 100644
--- a/libavutil/frame.h
+++ b/libavutil/frame.h
@@ -196,7 +196,8 @@ enum AVFrameSideDataType {
     /**
      * Dolby Vision RPU raw data, suitable for passing to x265
      * or other libraries. Array of uint8_t, with NAL emulation
-     * bytes intact.
+     * bytes intact. For AV1 the buffer instead holds the source Dolby Vision
+     * ITU-T T.35 payload, including its country code and provider header.
      */
     AV_FRAME_DATA_DOVI_RPU_BUFFER,
 
